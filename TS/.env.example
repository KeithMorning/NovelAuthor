# LLM Provider (anthropic, openai, deepseek, azure, gemini)
LLM_PROVIDER=deepseek

# API Keys
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
GEMINI_API_KEY=

# DeepSeek API Base (optional, defaults to https://api.deepseek.com)
DEEPSEEK_API_BASE=https://api.deepseek.com

# Model settings (optional, defaults will be used)
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
# OPENAI_MODEL=gpt-4o
# DEEPSEEK_MODEL=deepseek-reasoner
# GEMINI_MODEL=gemini-2.0-flash

# Writing settings
DEFAULT_CHAPTER_WORDS=4000
TEMPERATURE=0.7
MAX_TOKENS=8192

# Paths
NOVELS_DIR=./novels
OUTPUT_DIR=./output
