# =============================================================================
# 小说AI Agent - 环境配置文件
# =============================================================================

# -----------------------------------------------------------------------------
# LLM提供商选择 (必填)
# 支持: anthropic, openai, deepseek, azure
# -----------------------------------------------------------------------------
LLM_PROVIDER=anthropic

# -----------------------------------------------------------------------------
# Anthropic Claude配置
# 使用Claude时需要配置此项
# 获取API Key: https://console.anthropic.com/settings/keys
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_API_BASE=https://api.anthropic.com  # 可选,自定义API地址

# -----------------------------------------------------------------------------
# OpenAI配置
# 使用GPT系列模型时需要配置此项
# 获取API Key: https://platform.openai.com/api-keys
# -----------------------------------------------------------------------------
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_API_BASE=https://api.openai.com/v1  # 可选
# OPENAI_ORGANIZATION=your_org_id  # 可选

# -----------------------------------------------------------------------------
# DeepSeek配置
# 使用DeepSeek模型时需要配置此项
# 获取API Key: https://platform.deepseek.com/api_keys
# DeepSeek提供与OpenAI兼容的API接口
# -----------------------------------------------------------------------------
# DEEPSEEK_API_KEY=your_deepseek_api_key_here
# DEEPSEEK_API_BASE=https://api.deepseek.com/v1  # 默认值,一般不需要修改

# -----------------------------------------------------------------------------
# Azure OpenAI配置
# 使用Azure部署的OpenAI时需要配置此项
# -----------------------------------------------------------------------------
# AZURE_OPENAI_API_KEY=your_azure_key_here
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_DEPLOYMENT=your-deployment-name
# AZURE_OPENAI_API_VERSION=2024-02-01

# -----------------------------------------------------------------------------
# 模型配置
# 如果不指定DEFAULT_MODEL,系统会根据LLM_PROVIDER自动选择:
#   - anthropic: claude-sonnet-4-20250514
#   - openai: gpt-4o
#   - deepseek: deepseek-chat
#   - azure: gpt-4
# -----------------------------------------------------------------------------
# DEFAULT_MODEL=claude-sonnet-4-20250514
TEMPERATURE=0.7
MAX_TOKENS=4096

# -----------------------------------------------------------------------------
# 项目路径配置 (可选,使用默认值)
# -----------------------------------------------------------------------------
# OUTPUT_DIR=novel_ai_agent/output
# NOVELS_DIR=novel_ai_agent/output/novels
# OUTLINES_DIR=novel_ai_agent/output/outlines
# CHARACTERS_DIR=novel_ai_agent/output/characters

# -----------------------------------------------------------------------------
# 向量数据库配置
# -----------------------------------------------------------------------------
# CHROMA_PERSIST_DIRECTORY=novel_ai_agent/data/chroma

# -----------------------------------------------------------------------------
# Agent配置
# -----------------------------------------------------------------------------
# MAX_ITERATIONS=10
# VERBOSE=true

# -----------------------------------------------------------------------------
# 写作配置
# -----------------------------------------------------------------------------
# DEFAULT_CHAPTER_WORDS=3000

# 前文上下文：优先使用全文，超过字符预算后自动降级为摘要
# FULL_CONTEXT_MODE=true
# MAX_PREVIOUS_CONTEXT_CHARS=80000

# =============================================================================
# 使用示例
# =============================================================================
#
# 1. 使用Anthropic Claude (推荐用于高质量创作):
#    LLM_PROVIDER=anthropic
#    ANTHROPIC_API_KEY=sk-ant-xxxxx
#
# 2. 使用OpenAI GPT-4:
#    LLM_PROVIDER=openai
#    OPENAI_API_KEY=sk-xxxxx
#    DEFAULT_MODEL=gpt-4o
#
# 3. 使用DeepSeek (性价比高):
#    LLM_PROVIDER=deepseek
#    DEEPSEEK_API_KEY=sk-xxxxx
#    DEFAULT_MODEL=deepseek-chat
#
# 4. 使用Azure OpenAI:
#    LLM_PROVIDER=azure
#    AZURE_OPENAI_API_KEY=xxxxx
#    AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
#    AZURE_OPENAI_DEPLOYMENT=gpt-4
#
# =============================================================================
